digraph G {
  graph [
    rankdir=TB,
    bgcolor="white",
    pad="0.25",
    nodesep="0.35",
    ranksep="0.55",
    splines=polyline,
    fontname="Arial",
    fontsize=18,
    label="Task Exposure & Adoption Lag Assistant — Architecture",
    labelloc=t,
    labeljust=l
  ];

  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=11, margin="0.14,0.08", color="#5B6B7A", fillcolor="#F8FAFC"];
  edge [fontname="Arial", fontsize=9, color="#425466", arrowsize=0.8];

  subgraph cluster_perimeter {
    label="LOCAL WINDOWS 11 WORKSTATION — no public ingress";
    color="#475569";
    style="rounded,dashed";
    penwidth=2;

    subgraph cluster_presentation {
      label="PRESENTATION TIER — loopback only";
      color="#3B82F6";
      style="rounded,filled";
      fillcolor="#EFF6FF";

      browser [label="Browser\nhttp://127.0.0.1:8501", fillcolor="#FFFFFF"];
      ui [label="Streamlit App\nStateless presentation\n• exposure table\n• role-level lag p10 / p50 / p90\n• calibration\n• provenance: quote + page", fillcolor="#DBEAFE"];
      browser -> ui [label="loopback only"];
    }

    subgraph cluster_orch {
      label="ORCHESTRATION TIER — LangGraph bounded state machine";
      color="#22C55E";
      style="rounded,filled";
      fillcolor="#F0FDF4";

      intent [label="1. Intent & Scope\nAnthropic\nResolve SOC / NAICS / geography", fillcolor="#FFFFFF"];
      retrieve [label="2. Evidence Retrieval\nView-backed tools only", fillcolor="#FFFFFF"];
      classify [label="3A. Task Classifier\nOpenAI\nCategorical judgments only:\nroutine / cognitive / manual /\ntacitness / direction / confidence", fillcolor="#E0F2FE"];

      exposure [label="3B. EXPOSURE PATH\nDeterministic Python\nExposureScorer + TacitnessPenalty\nPer-task exposure → role exposure index", fillcolor="#EDE9FE", color="#7C3AED", penwidth=2];

      lag [label="3C. LAG PATH\nDeterministic Python\nLagModel\nRole-level p10 / p50 / p90\nNo task-level lag", fillcolor="#FEF3C7", color="#D97706", penwidth=2];

      gate [label="4. REVIEW GATE\nAnthropic\nConvergence point ONLY\n• evidence + confidence present\n• caveats non-empty\n• calibration tolerance checked", fillcolor="#DCFCE7", color="#15803D", penwidth=2];

      synth [label="5. Synthesis\nOpenAI\nNarrates persisted verdict only\nNo new figures", fillcolor="#FFFFFF"];

      rejected [label="TERMINATE RUN\ngate_rejected\nNO REPORT PRODUCED", fillcolor="#FEE2E2", color="#DC2626", penwidth=2];

      intent -> retrieve [label="resolved scope"];
      retrieve -> classify [label="role tasks + exposure evidence"];
      classify -> exposure [label="categorical task judgments"];

      retrieve -> lag [label="adoption observations + historical claims", color="#D97706", fontcolor="#92400E", penwidth=2];

      exposure -> gate [label="exposure result", color="#7C3AED", fontcolor="#5B21B6", penwidth=2];
      lag -> gate [label="lag interval", color="#D97706", fontcolor="#92400E", penwidth=2];

      gate -> synth [label="PASS"];
      gate -> rejected [label="FAIL", color="#DC2626", fontcolor="#B91C1C"];
      synth -> ui [label="RoleVerdict + provenance"];
    }

    subgraph cluster_data {
      label="DATA & INTEGRATION TIER — SQL Server 127.0.0.1:1433 — FDE_TaskExposure";
      color="#F59E0B";
      style="rounded,filled";
      fillcolor="#FFF7ED";

      subgraph cluster_visible {
        label="AGENT-VISIBLE TRUST REGION — USR_FDE_RO";
        color="#16A34A";
        style="rounded,dashed";
        views [label="READ-ONLY VIEWS\nVW_ROLE_TASKS\nVW_EXPOSURE_BENCHMARK\nVW_ADOPTION_CURVE\nVW_CLAIM_EVIDENCE\nVW_INDUSTRY_METRIC", fillcolor="#ECFDF5", color="#16A34A"];
      }

      subgraph cluster_hidden {
        label="AGENT-INVISIBLE BASE TABLES";
        color="#DC2626";
        style="rounded,dashed";
        base [label="ref.*\ncore.*\nscore.*\naudit.*\nDENIED to USR_FDE_RO", fillcolor="#FEF2F2", color="#DC2626"];
      }

      audit [label="audit.AgentAuditLog\nAPPEND-ONLY\nTool_Raw_Output stored unmodified\nDENY UPDATE/DELETE + blocking trigger", fillcolor="#F3E8FF", color="#9333EA"];

      binding [label="audit.run_source_binding\nrun_id -> source_doc_id -> usage_type\nbound on CONSUMPTION, not availability\ndoc_id IS the version: no source_version column", fillcolor="#F3E8FF", color="#9333EA"];

      adapter [label="Local Audit Adapter\nholds USR_FDE_AUDIT\nINSERT on the log ONLY\nno orchestration node holds a write credential", shape=component, fillcolor="#FDF4FF", color="#9333EA"];

      score [label="score.*\nrun • task_score • role_verdict • calibration", fillcolor="#FAF5FF", color="#9333EA"];

      landing [label="LANDING ZONE\ndata/raw • data/docs\nSHA-256 digest per artefact\nprovenance_note • retrieved_at", fillcolor="#F8FAFC", color="#475569"];

      ingest [label="Offline Ingestion\nseparate from serving\nUSR_FDE_LOAD\nPydantic-normalised contracts", fillcolor="#FFFBEB", color="#CA8A04"];

      views -> retrieve [dir=back, label="SELECT only\nUSR_FDE_RO", color="#16A34A", fontcolor="#166534"];
      base -> views [label="projected through controlled views", style=dashed, arrowhead=none];

      exposure -> score [label="INSERT scoring outputs\nUSR_FDE_SCORE", color="#7C3AED", fontcolor="#5B21B6"];
      lag -> score [label="INSERT lag outputs\nUSR_FDE_SCORE", color="#D97706", fontcolor="#92400E"];
      score -> gate [label="persisted outputs"];

      ingest -> base [label="INSERT (append-only) ref.*, core.*\nidempotent on SHA-256 + natural key\nUSR_FDE_LOAD"];
      landing -> ingest [label="typed load"];

      intent -> adapter [label="emit", color="#9333EA", style=dotted];
      retrieve -> adapter [label="emit", color="#9333EA", style=dotted];
      classify -> adapter [label="emit", color="#9333EA", style=dotted];
      exposure -> adapter [label="emit", color="#9333EA", style=dotted];
      lag -> adapter [label="emit", color="#9333EA", style=dotted];
      gate -> adapter [label="emit", color="#9333EA", style=dotted];
      synth -> adapter [label="emit", color="#9333EA", style=dotted];
      adapter -> audit [label="INSERT\nUSR_FDE_AUDIT", color="#9333EA", penwidth=2];
      score -> binding [label="sources consumed\nUSR_FDE_SCORE", color="#9333EA", style=dashed];
    }

    firewall [label="Windows Firewall\nINBOUND 1433 BLOCKED\nSQL Server bound to 127.0.0.1 only", shape=note, fillcolor="#F1F5F9", color="#64748B"];
    firewall -> base [style=dashed, arrowhead=none];
  }

  subgraph cluster_external {
    label="EXTERNAL — HTTPS EGRESS ONLY / NO INBOUND PATH";
    color="#64748B";
    style="rounded,dashed";

    models [label="Model Providers\nAnthropic API\nOpenAI API", fillcolor="#F8FAFC"];
    sources [label="Source Systems\nBEA • BLS • Census • FRED\nO*NET • exposure XLSX • BTOS XLSX • PDFs", fillcolor="#F8FAFC"];
  }

  classify -> models [label="HTTPS egress only", color="#2563EB"];
  gate -> models [label="HTTPS egress only", color="#2563EB"];
  synth -> models [label="HTTPS egress only", color="#2563EB"];
  sources -> landing [label="HTTPS egress fetch\n(no serving dependency)", dir=back, color="#2563EB"];

  provenance [label="TRACEABILITY GUARANTEE\nCustomer figure → score.* → run/source binding → immutable core.* / ref.source_document → SHA-256 artefact\nProse claim → Claim_ID → verbatim Quote + Page + Publisher\nSurvives a source revision: append-only means a past run still resolves to what it saw", shape=box, style="rounded,filled", fillcolor="#EEF2FF", color="#4F46E5", penwidth=2];
  score -> provenance [style=dashed, arrowhead=none];
  landing -> provenance [style=dashed, arrowhead=none];
}
