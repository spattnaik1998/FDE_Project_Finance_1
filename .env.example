# Copy to .env and fill in. .env is gitignored and must never be committed.
# Format: KEY = 'value'  (the loader also accepts KEY=value and KEY: value)

# --- Data sources (required for ingestion) -----------------------------
# BEA     https://apps.bea.gov/API/signup/
# Census  https://api.census.gov/data/key_signup.html
# FRED    https://fredaccount.stlouisfed.org/apikeys
# BLS     https://data.bls.gov/registrationEngine/
BEA_API_KEY = ''
CENSUS_API_KEY = ''
FRED_API_KEY = ''
BLS_API_KEY = ''

# --- Model providers (required for the orchestration tier) --------------
OPENAI_API_KEY = ''
ANTHROPIC_API_KEY = ''

# --- Model profile ------------------------------------------------------
# Which set of models runs the OpenAI stages. Two profiles, because the choice
# is one decision made four times.
#
#   economy (default)  gpt-5.4-mini at low effort. Development, tests,
#                      rehearsal. ~3x faster and far cheaper per token.
#   full               gpt-6-astra at medium effort. What a run you intend to
#                      hand a client uses.
#
# Note: the token COUNT per call is about the same either way (the schema fixes
# the shape of the answer). The saving is price and latency.
#
# Note: the cohort reference set is keyed on the classifier model, so an
# economy run finds no reference scored by it and its calibration reads as
# unidentifiable. The Review Gate blocks an economy run from being marked
# customer-deliverable for exactly that reason.
# MODEL_PROFILE = 'economy'

# --- Optional per-stage overrides ---------------------------------------
# These win over the profile, for raising one stage without editing profiles.
# MODEL_CLASSIFIER = 'gpt-6-astra'
# MODEL_WRITER = 'gpt-6-astra'
# MODEL_ORCHESTRATOR = 'claude-opus-5'
# MODEL_REVIEW_GATE = 'claude-opus-5'
# REASONING_EFFORT = 'medium'        # low | medium | high | xhigh
# CLASSIFIER_CONCURRENCY = '6'
